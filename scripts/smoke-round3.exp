#!/usr/bin/expect -f
set timeout 20
# sleep starves the pty (the app blocks writing to a full buffer on a
# single-threaded runtime); drain reads while waiting instead.
proc drain {secs} {
    set save $::timeout
    set ::timeout $secs
    expect -re {ZZZ_NEVER_MATCHES_ZZZ}
    set ::timeout $save
}
# Robust gate: poll with a full repaint (Ctrl-L) before each 1s match
# attempt, so changed titles are re-emitted contiguously AFTER the state
# change lands (a single early repaint can render before an async event).
proc gate {pattern {action {}} {total 15}} {
    set deadline [expr {[clock seconds] + $total}]
    while {[clock seconds] < $deadline} {
        send "\x0c"
        set ::timeout 1
        expect {
            -ex $pattern { set ::timeout 15; uplevel $action; return }
            timeout {}
            eof { send_user "\nFAIL: unexpected EOF waiting for '$pattern'\n"; exit 1 }
        }
    }
    send_user "\nFAIL: gate '$pattern' not reached in ${total}s\n"
    exit 1
}
set S [lindex $argv 0]
set env(EDITOR) "$S/fake-editor.sh"
set env(XDG_CONFIG_HOME) "$S/xdg-round3"
spawn ./target/debug/lazymongo mongodb://localhost:27099
stty rows 40 columns 140 < $spawn_out(slave,name)
gate "app_db"
drain 2
# Ctrl-T namespace switcher (collections were prefetched)
send "\x14"
gate "Open collection"
send "app users"
drain 1
send "\r"
gate "Results ─ app_db.users"
gate "User 0" { send_user "\n=== SWITCHER OK ===\n" }
drain 1
# c = duplicate first doc -> prefilled editor -> ^s inserts the copy
send "c"
gate "Duplicate document"
send "\x13"
gate "inserted _id="
send_user "\n=== DUPLICATE OK ===\n"
drain 1
# E = full streaming export (501 docs, beyond any single page)
send "E"
gate "docs to lazymongo-app_db.users-" { send_user "\n=== STREAM EXPORT OK ===\n" }
drain 1
# Ctrl-E = external $EDITOR on the first doc; fake editor bumps age to 99
send "g"
send "\x05"
gate "Apply edit"
gate "changes: ~ age"
send "y"
gate "matched 1" { send_user "\n=== EXTERNAL EDITOR OK ===\n" }
drain 1
send "q"
expect eof
send_user "\n=== ROUND CLEAN EXIT ===\n"
