#!/usr/bin/expect -f
set timeout 15
set uri [lindex $argv 0]
if {$uri eq ""} { set uri "mongodb://localhost:27099" }
spawn ./target/debug/lazymongo $uri
stty rows 35 columns 140 < $spawn_out(slave,name)
expect { "app_db" {} timeout { send_user "\nFAIL: connect\n"; exit 1 } }
sleep 1
send "jj\r"
expect { "users" {} timeout { send_user "\nFAIL: collections\n"; exit 1 } }
sleep 1
send "jj\r"
expect { "User 0" { send_user "\n=== JSON VIEW OK ===\n" } timeout { send_user "\nFAIL: docs\n"; exit 1 } }
sleep 1
# Table view: header should show columns and [table] in the title
send "v"
expect { "\[table\]" { send_user "\n=== TABLE VIEW OK ===\n" } timeout { send_user "\nFAIL: table\n"; exit 1 } }
sleep 1
# Sort by active column (_id -> toggles server sort, re-runs query)
send "lls"
expect { "email↑" { send_user "\n=== SORT OK ===\n" } timeout { send_user "\nFAIL: sort\n"; exit 1 } }
sleep 1
# Open a row as full-screen document
send "\r"
expect { "doc 1" { send_user "\n=== DOC VIEW OK ===\n" } timeout { send_user "\nFAIL: docview\n"; exit 1 } }
send "\x1b"
sleep 1
# Structured query editor: set a limit
send "F"
expect { "projection" { send_user "\n=== QUERY EDITOR OK ===\n" } timeout { send_user "\nFAIL: query editor\n"; exit 1 } }
# focus filter field; tab x3 to limit; type 7; run
send "\t\t\t7\r"
expect { "(7 loaded, all)" { send_user "\n=== LIMIT APPLIED OK ===\n" } timeout { send_user "\nFAIL: limit\n"; exit 1 } }
sleep 1
# Explain popup
send "x"
expect { "executionStats" { send_user "\n=== EXPLAIN OK ===\n" } timeout { send_user "\nFAIL: explain\n"; exit 1 } }
send "\x1b"
sleep 1
send "q"
expect eof
send_user "\n=== CLEAN EXIT ===\n"
