#!/usr/bin/expect -f
# Shift+Enter (kitty protocol CSI 13;2u) runs the aggregation pipeline and
# submits the JSON editor, Colab-style.
set timeout 15
proc drain {secs} {
    set save $::timeout
    set ::timeout $secs
    expect -re {ZZZ_NEVER_MATCHES_ZZZ}
    set ::timeout $save
}
# Robust gate: poll with a full repaint (Ctrl-L) before each 1s match
# attempt, so changed titles are re-emitted contiguously AFTER the state
# change lands (a single early repaint can render before an async event).
proc gate {pattern {action {}} {total 15}} {
    set deadline [expr {[clock seconds] + $total}]
    while {[clock seconds] < $deadline} {
        send "\x0c"
        set ::timeout 1
        expect {
            -ex $pattern { set ::timeout 15; uplevel $action; return }
            timeout {}
            eof { send_user "\nFAIL: unexpected EOF waiting for '$pattern'\n"; exit 1 }
        }
    }
    send_user "\nFAIL: gate '$pattern' not reached in ${total}s\n"
    exit 1
}
set uri [lindex $argv 0]
if {$uri eq ""} { set uri "mongodb://localhost:27099" }
spawn ./target/debug/lazymongo $uri
stty rows 40 columns 140 < $spawn_out(slave,name)
gate "app_db"
drain 1
send "/app_db\r"
drain 0.5
send "\r"
gate "users"
send "jj\r"
gate "loaded"
drain 1
# Aggregation editor: default pipeline, run with Shift+Enter
send "a"
gate "Pipeline"
send "\x1b\[13;2u"
gate "through stage 1" { send_user "\n=== AGG SHIFT-ENTER OK ===\n" }
send "\x1b"
drain 0.2
send "\x1b"
drain 0.2
drain 1
# JSON editor (duplicate doc) submitted with Shift+Enter
send "c"
gate "Duplicate document"
send "\x1b\[13;2u"
gate "inserted _id=" { send_user "\n=== EDITOR SHIFT-ENTER OK ===\n" }
drain 1
send "q"
expect eof
send_user "\n=== SHIFT-ENTER CLEAN EXIT ===\n"
