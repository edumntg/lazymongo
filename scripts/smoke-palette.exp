#!/usr/bin/expect -f
set timeout 15
# sleep starves the pty (the app blocks writing to a full buffer on a
# single-threaded runtime); drain reads while waiting instead.
proc drain {secs} {
    set save $::timeout
    set ::timeout $secs
    expect -re {ZZZ_NEVER_MATCHES_ZZZ}
    set ::timeout $save
}
# Robust gate: poll with a full repaint (Ctrl-L) before each 1s match
# attempt, so changed titles are re-emitted contiguously AFTER the state
# change lands (a single early repaint can render before an async event).
proc gate {pattern {action {}} {total 15}} {
    set deadline [expr {[clock seconds] + $total}]
    while {[clock seconds] < $deadline} {
        send "\x0c"
        set ::timeout 1
        expect {
            -ex $pattern { set ::timeout 15; uplevel $action; return }
            timeout {}
            eof { send_user "\nFAIL: unexpected EOF waiting for '$pattern'\n"; exit 1 }
        }
    }
    send_user "\nFAIL: gate '$pattern' not reached in ${total}s\n"
    exit 1
}
set S [lindex $argv 0]
set env(XDG_CONFIG_HOME) "$S/xdg-pal"
spawn ./target/debug/lazymongo mongodb://localhost:27099
stty rows 40 columns 140 < $spawn_out(slave,name)
gate "app_db"
drain 1
send "/app_db\r"
drain 1
send "\r"
gate "users"
drain 1
send "jj\r"
gate "User 0"
drain 1
# In-results search: jump to the doc containing "User 49"
send "/User 49\r"
drain 1
send "o"
gate "doc 50" { send_user "\n=== SEARCH JUMP OK ===\n" }
send "\x1b"
drain 0.2
drain 1
# Command palette: toggle to table view
send "\x10"
gate "Command palette"
send "toggle"
drain 1
send "\r"
gate "\[table\]" { send_user "\n=== PALETTE ACTION OK ===\n" }
drain 1
# Palette: switch theme to termius, persists to config
send ":"
gate "Command palette"
send "termius"
drain 1
send "\r"
gate "theme: termius (saved)" { send_user "\n=== THEME SWITCH OK ===\n" }
drain 1
send "q"
expect eof
send_user "\n=== PALETTE/SEARCH CLEAN EXIT ===\n"
