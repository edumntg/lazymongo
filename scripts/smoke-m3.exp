#!/usr/bin/expect -f
set timeout 15
# sleep starves the pty (the app blocks writing to a full buffer on a
# single-threaded runtime); drain reads while waiting instead.
proc drain {secs} {
    set save $::timeout
    set ::timeout $secs
    expect -re {ZZZ_NEVER_MATCHES_ZZZ}
    set ::timeout $save
}
# Robust gate: poll with a full repaint (Ctrl-L) before each 1s match
# attempt, so changed titles are re-emitted contiguously AFTER the state
# change lands (a single early repaint can render before an async event).
proc gate {pattern {action {}} {total 15}} {
    set deadline [expr {[clock seconds] + $total}]
    while {[clock seconds] < $deadline} {
        send "\x0c"
        set ::timeout 1
        expect {
            -ex $pattern { set ::timeout 15; uplevel $action; return }
            timeout {}
            eof { send_user "\nFAIL: unexpected EOF waiting for '$pattern'\n"; exit 1 }
        }
    }
    send_user "\nFAIL: gate '$pattern' not reached in ${total}s\n"
    exit 1
}
set uri [lindex $argv 0]
if {$uri eq ""} { set uri "mongodb://localhost:27099" }
spawn ./target/debug/lazymongo $uri
stty rows 40 columns 140 < $spawn_out(slave,name)
gate "app_db"
drain 1
# Filter sidebar to smoke_db, expand, open items
send "/smoke\r"
drain 1
send "\r"
gate "items"
drain 1
send "j\r"
gate "(10 loaded, all)"
send_user "\n=== OPENED items (10 docs) ===\n"
drain 1
# INSERT: i -> editor -> move to line 2 and type a field -> ^s
send "i"
gate "Insert document"
send "\x1b\[B"
send "\"a\": 1"
send "\x13"
gate "inserted _id="
gate "(11 loaded, all)"
send_user "\n=== INSERT OK (11 docs) ===\n"
drain 1
# DELETE ONE: d on first doc -> confirm y
send "gd"
gate "Delete document"
send "y"
gate "(10 loaded, all)"
send_user "\n=== DELETE ONE OK (10 docs) ===\n"
drain 1
# DELETE MANY: filter n >= 5 (5 docs), D, type count 5, enter
send "3"
send "{ n: { \$gte: 5 } }\r"
gate "(5 loaded, all)"
send "D"
gate "Type the count (5)"
send "5\r"
gate "deleted 5 docs"
send_user "\n=== DELETE MANY OK ===\n"
drain 1
# Reset filter by reopening the collection from the explorer
send "\x1b"
drain 0.2
send "1"
send "\r"
gate "(5 loaded, all)"
drain 1
# UPDATE MANY: U -> editor prefilled with $set -> add field -> ^s -> confirm y
send "2U"
gate "Update many"
send "\x1b\[B\x1b\[B"
send "\"x\": 9"
send "\x13"
gate "will be modified"
send "y"
gate "updated 5 docs"
send_user "\n=== UPDATE MANY OK ===\n"
drain 1
# EDIT DOC: e -> save unchanged -> confirm shows no changes -> y -> replaced
send "e"
gate "Edit document"
send "\x13"
gate "Apply edit"
send "y"
gate "matched 1"
send_user "\n=== EDIT DOC OK ===\n"
drain 1
# INDEXES: I -> create n_1 -> drop it
send "I"
gate "_id_"
send "c"
gate "Create index"
send "\x1b\[B"
send "\"n\": 1"
send "\x13"
gate "keys:"
send "y"
gate "n_1"
send_user "\n=== CREATE INDEX OK ===\n"
drain 1
send "j"
send "d"
gate "Drop index"
send "y"
gate "dropped index n_1"
send_user "\n=== DROP INDEX OK ===\n"
send "\x1b"
drain 0.2
drain 1
# OPS LOG
send "L"
gate "updated 5 docs"
send_user "\n=== OPS LOG OK ===\n"
send "\x1b"
drain 0.2
drain 1
# CREATE + DROP COLLECTION from explorer
send "1"
send "N"
gate "New collection"
send "tmpcoll\r"
gate "created collection smoke_db.tmpcoll"
send_user "\n=== CREATE COLLECTION OK ===\n"
drain 1
send "j"
send "X"
gate "Type the collection name"
send "tmpcoll\r"
gate "dropped collection smoke_db.tmpcoll"
send_user "\n=== DROP COLLECTION OK ===\n"
drain 1
send "q"
expect eof
send_user "\n=== M3 CLEAN EXIT ===\n"
