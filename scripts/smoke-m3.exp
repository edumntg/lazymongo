#!/usr/bin/expect -f
set timeout 15
set uri [lindex $argv 0]
if {$uri eq ""} { set uri "mongodb://localhost:27099" }
spawn ./target/debug/lazymongo $uri
stty rows 40 columns 140 < $spawn_out(slave,name)
expect { "app_db" {} timeout { send_user "\nFAIL connect\n"; exit 1 } }
sleep 1
# Filter sidebar to smoke_db, expand, open items
send "/smoke\r"
sleep 1
send "\r"
expect { "items" {} timeout { send_user "\nFAIL smoke_db expand\n"; exit 1 } }
sleep 1
send "j\r"
expect { "(10 loaded, all)" {} timeout { send_user "\nFAIL open items\n"; exit 1 } }
send_user "\n=== OPENED items (10 docs) ===\n"
sleep 1
# INSERT: i -> editor -> move to line 2 and type a field -> ^s
send "i"
expect { "Insert document" {} timeout { send_user "\nFAIL insert editor\n"; exit 1 } }
send "\x1b\[B"
send "\"a\": 1"
send "\x13"
expect { "inserted _id=" {} timeout { send_user "\nFAIL insert\n"; exit 1 } }
expect { "(11 loaded, all)" {} timeout { send_user "\nFAIL insert refresh\n"; exit 1 } }
send_user "\n=== INSERT OK (11 docs) ===\n"
sleep 1
# DELETE ONE: d on first doc -> confirm y
send "gd"
expect { "Delete document" {} timeout { send_user "\nFAIL delete confirm\n"; exit 1 } }
send "y"
expect { "(10 loaded, all)" {} timeout { send_user "\nFAIL delete refresh\n"; exit 1 } }
send_user "\n=== DELETE ONE OK (10 docs) ===\n"
sleep 1
# DELETE MANY: filter n >= 5 (5 docs), D, type count 5, enter
send "3"
send "{ n: { \$gte: 5 } }\r"
expect { "(5 loaded, all)" {} timeout { send_user "\nFAIL filter\n"; exit 1 } }
send "D"
expect { "Type the count (5)" {} timeout { send_user "\nFAIL deletemany dryrun\n"; exit 1 } }
send "5\r"
expect { "deleted 5 docs" {} timeout { send_user "\nFAIL deletemany\n"; exit 1 } }
send_user "\n=== DELETE MANY OK ===\n"
sleep 1
# Reset filter by reopening the collection from the explorer
send "\x1b"
send "1"
send "\r"
expect { "(5 loaded, all)" {} timeout { send_user "\nFAIL reopen\n"; exit 1 } }
sleep 1
# UPDATE MANY: U -> editor prefilled with $set -> add field -> ^s -> confirm y
send "2U"
expect { "Update many" {} timeout { send_user "\nFAIL updatemany editor\n"; exit 1 } }
send "\x1b\[B\x1b\[B"
send "\"x\": 9"
send "\x13"
expect { "will be modified" {} timeout { send_user "\nFAIL updatemany dryrun\n"; exit 1 } }
send "y"
expect { "updated 5 docs" {} timeout { send_user "\nFAIL updatemany\n"; exit 1 } }
send_user "\n=== UPDATE MANY OK ===\n"
sleep 1
# EDIT DOC: e -> save unchanged -> confirm shows no changes -> y -> replaced
send "e"
expect { "Edit document" {} timeout { send_user "\nFAIL edit editor\n"; exit 1 } }
send "\x13"
expect { "Apply edit" {} timeout { send_user "\nFAIL edit confirm\n"; exit 1 } }
send "y"
expect { "matched 1" {} timeout { send_user "\nFAIL edit apply\n"; exit 1 } }
send_user "\n=== EDIT DOC OK ===\n"
sleep 1
# INDEXES: I -> create n_1 -> drop it
send "I"
expect { "_id_" {} timeout { send_user "\nFAIL indexes\n"; exit 1 } }
send "c"
expect { "Create index" {} timeout { send_user "\nFAIL index editor\n"; exit 1 } }
send "\x1b\[B"
send "\"n\": 1"
send "\x13"
expect { "keys:" {} timeout { send_user "\nFAIL index confirm\n"; exit 1 } }
send "y"
expect { "n_1" {} timeout { send_user "\nFAIL index created\n"; exit 1 } }
send_user "\n=== CREATE INDEX OK ===\n"
sleep 1
send "j"
send "d"
expect { "Drop index" {} timeout { send_user "\nFAIL drop index confirm\n"; exit 1 } }
send "y"
expect { "dropped index n_1" {} timeout { send_user "\nFAIL drop index\n"; exit 1 } }
send_user "\n=== DROP INDEX OK ===\n"
send "\x1b"
sleep 1
# OPS LOG
send "L"
expect { "updated 5 docs" {} timeout { send_user "\nFAIL ops log\n"; exit 1 } }
send_user "\n=== OPS LOG OK ===\n"
send "\x1b"
sleep 1
# CREATE + DROP COLLECTION from explorer
send "1"
send "N"
expect { "New collection" {} timeout { send_user "\nFAIL create coll prompt\n"; exit 1 } }
send "tmpcoll\r"
expect { "created collection smoke_db.tmpcoll" {} timeout { send_user "\nFAIL create coll\n"; exit 1 } }
send_user "\n=== CREATE COLLECTION OK ===\n"
sleep 1
send "j"
send "X"
expect { "Type the collection name" {} timeout { send_user "\nFAIL drop coll confirm\n"; exit 1 } }
send "tmpcoll\r"
expect { "dropped collection smoke_db.tmpcoll" {} timeout { send_user "\nFAIL drop coll\n"; exit 1 } }
send_user "\n=== DROP COLLECTION OK ===\n"
sleep 1
send "q"
expect eof
send_user "\n=== M3 CLEAN EXIT ===\n"
